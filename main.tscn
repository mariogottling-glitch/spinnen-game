theme_override_constants/line_spacing = 24
theme_override_font_sizes/font_size = 25
text = "1   JAGDVERTRAG WÄHLEN\nEntscheide vor jedem Level, welches Risiko und welche Belohnung deine Jagd verändert.\n\n2   NETZFORMEN BAUEN\nDreiecke werden Fangtaschen. Knoten mit vier Fäden werden reparierende Seidenherzen.\n\n3   ANFLÜGE LESEN\nGestrichelte Korridore kündigen Tiere an. Käfer brauchen starke Formen, Libellen wenden und Glühwürmchen beruhigen das Netz.\n\n4   AKTIV ZUSCHLAGEN\nTippe auf gefangene Beute, bevor der Ring abläuft. Nutze Netz zupfen für riskante Schwärme.\n\n5   DEINEN BUILD FORMEN\nSammle XP und kombiniere Perks passend zu Vertrag und Spezialtieren."
autowrap_mode = 2

